# Disable welcome message
set -g fish_greeting

# Ensure ~/.local/bin is on PATH before the interactive block below
# (herdr lives there and the auto-launch needs to resolve it).
set -gx PATH $HOME/.local/bin $PATH

if status is-interactive
    # Enable vim keybindings
    fish_vi_key_bindings
    # Auto-launch herdr if not already inside a herdr pane
    if not set -q HERDR_PANE_ID
        exec herdr
    end
end

# starship
starship init fish | source

# bun
set --export BUN_INSTALL "$HOME/.bun/bin"
set --export PATH $BUN_INSTALL/bin $PATH

# go
set --export PATH /usr/bin/go $PATH
set --export PATH $HOME/go/bin $PATH

# claude migrated
alias claude="$HOME/.local/bin/claude"

{{- if eq .chezmoi.os "darwin" }}
# pip3 (macOS)
set -gx PATH $HOME/Library/Python/3.9/bin $PATH
{{- end }}
